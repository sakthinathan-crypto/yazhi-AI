# ===================================================
# YAZHI – PERSONAL AI CALL ASSISTANT
# Environment Configuration
# ===================================================

# --- Google Gemini AI ---
# Gemini API Key used for Gemini Live real-time audio and Gemini 3.8 Flash summarization
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_LIVE_MODEL="gemini-3.8-live"
GEMINI_SUMMARY_MODEL="gemini-3.8-flash"

# --- Telephony (Exotel Voicebot & AgentStream) ---
EXOTEL_ACCOUNT_SID="your_exotel_account_sid"
EXOTEL_API_KEY="your_exotel_api_key"
EXOTEL_API_TOKEN="your_exotel_api_token"
EXOTEL_SUBDOMAIN="api.exotel.com"
EXOTEL_PHONE_NUMBER="+91XXXXXXXXXX"
EXOTEL_CALL_TIMEOUT="25"

# --- Supabase Database & Auth ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Telegram Bot Notifications ---
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# --- Server / Host URL ---
# Backend public endpoint for Exotel webhooks and WebSocket audio streams
APP_URL="https://your-backend.up.railway.app"
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="development"
